bin/
obj/
*.user
.vs/
artifacts/
*.nupkg
*.snupkg
hello*.wav
*.wav

# Throwaway spikes and forced-HD voice package copies. Spikes are local
# experiments only - some carry multi-hundred-megabyte ONNX models - so the
# pattern covers every spike rather than naming them one at a time.
spike-*/
voicepkg-*/


# DocFX generated site and API metadata (regenerate with: dotnet docfx docfx.json)
docs/_site/
api/.manifest
docs/api/*.yml
docs/api/.manifest

# Pitch deck media. The committed live-voiceover.pptx is the lightweight deck;
# the review copy embeds the demo video and both are far too large for git.
docs/pitch/*.mp4
docs/pitch/*.review.pptx
