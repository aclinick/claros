{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src",
          "files": [ "Claros.csproj" ]
        }
      ],
      "dest": "docs/api",
      "outputFormat": "mref",
      "namespaceLayout": "nested",
      "memberLayout": "separatePages",
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "src": "docs",
        "files": [ "api/**.yml", "api/index.md", "index.md", "toc.yml", "*.md" ]
      }
    ],
    "output": "docs/_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "Claros",
      "_appTitle": "Claros API reference",
      "_appFooter": "Claros \u2013 offline TTS with Windows on-device Natural Voices",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
