<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Windows.Speech</RootNamespace>
    <AssemblyName>Windows.Speech</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackageId>Windows.Speech</PackageId>
    <Version>0.1.0</Version>
    <Authors>Andrew Clinick</Authors>
    <Description>End-to-end offline TTS on Windows. Enumerates installed Windows Natural Voices, runs their on-device ONNX acoustic model and vocoder via stock ONNX Runtime, and uses the shipped Windows SAPI text preprocessor for grapheme-to-phoneme conversion. No cloud, no separate G2P engine.</Description>
    <PackageTags>tts;speech;onnx;natural-voices;windows;sapi;offline</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/aclinick/ttslib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aclinick/ttslib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Windows.Speech.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.47.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
    <PackageReference Include="OnnxSharp" Version="0.3.2" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>

</Project>
