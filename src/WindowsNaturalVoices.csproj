<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WindowsNaturalVoices</RootNamespace>
    <AssemblyName>WindowsNaturalVoices</AssemblyName>
    <LangVersion>latest</LangVersion>

    <Description>Enumerate installed Windows Natural Voices as AppExtensions and run their ONNX acoustic models via stock ONNX Runtime. Demonstrates that the on-disk protection is a plaintext EULA and one undocumented custom op, not encryption.</Description>
    <Authors>Andrew Clinick</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" />
    <PackageReference Include="OnnxSharp" Version="0.3.2" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>

</Project>
