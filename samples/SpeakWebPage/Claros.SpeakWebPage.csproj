<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Claros.SpeakWebPage</RootNamespace>

    <!--
      EmbeddedSpeechSynthesizer loads the native Azure Embedded Speech core next to
      the app and stages the gated OS extensions beside it, so the app must be
      built for a concrete runtime (the native core lands in the output root
      instead of a runtimes\ subfolder). Run with an explicit RID, e.g.
      dotnet run -r win-arm64  (or  -r win-x64).
    -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Claros.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.5.2" />
    <PackageReference Include="SmartReader" Version="0.11.0" />
  </ItemGroup>

</Project>
