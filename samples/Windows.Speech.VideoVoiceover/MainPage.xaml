<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Windows.Speech_VideoVoiceover.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Windows.Speech_VideoVoiceover"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Command bar: open a video, choose the voiceover language  -->
        <Grid Grid.Row="0" Padding="24,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="OpenVideoButton"
                Grid.Column="0"
                AutomationProperties.AutomationId="OpenVideoButton"
                AutomationProperties.Name="Open video"
                Click="OpenVideoButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE898;" />
                    <TextBlock Text="Open video…" />
                </StackPanel>
            </Button>

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Voiceover" />

            <ComboBox
                x:Name="LanguageComboBox"
                Grid.Column="2"
                MinWidth="280"
                AutomationProperties.AutomationId="LanguageComboBox"
                AutomationProperties.Name="Voiceover language"
                DisplayMemberPath="Label"
                IsEnabled="{x:Bind ViewModel.AreVoicesReady, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.Languages}"
                PlaceholderText="Select a language"
                SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                SelectionChanged="LanguageComboBox_SelectionChanged" />

            <CheckBox
                x:Name="ShowCaptionsToggle"
                Grid.Column="3"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ShowCaptionsToggle"
                AutomationProperties.Name="Show captions"
                Content="Show captions"
                IsChecked="{x:Bind ViewModel.ShowCaptions, Mode=TwoWay}" />

            <TextBlock
                Grid.Column="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.VideoName, Mode=OneWay}" />
        </Grid>

        <!--  Video stage with a live caption of the currently spoken sentence  -->
        <Grid Grid.Row="1" Margin="24,0,24,0">
            <MediaPlayerElement
                x:Name="VideoPlayer"
                AreTransportControlsEnabled="True"
                AutoPlay="False"
                Stretch="Uniform">
                <MediaPlayerElement.TransportControls>
                    <MediaTransportControls
                        IsCompact="False"
                        ShowAndHideAutomatically="False" />
                </MediaPlayerElement.TransportControls>
            </MediaPlayerElement>

            <!--  Active voice note (top-left)  -->
            <Border
                Margin="12,12,0,0"
                Padding="12,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="{x:Bind local:MainPage.NonEmptyToVisible(ViewModel.ActiveVoice), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE767;" />
                    <TextBlock
                        AutomationProperties.AutomationId="ActiveVoiceText"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.ActiveVoice, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!--  Currently-spoken sentence (bottom, above transport controls)  -->
            <Border
                x:Name="CaptionBand"
                MaxWidth="900"
                Margin="0,0,0,88"
                Padding="20,12"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="CaptionBand"
                Background="#CC000000"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Visibility="{x:Bind local:MainPage.CaptionVisible(ViewModel.ShowCaptions, ViewModel.CurrentSentence), Mode=OneWay}">
                <TextBlock
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="CurrentSentenceText"
                    Foreground="White"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.CurrentSentence, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!--  Status line  -->
        <Border
            Grid.Row="2"
            Padding="24,10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="StatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </Border>
    </Grid>
</Page>
