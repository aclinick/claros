<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Windows.Speech_VideoVoiceover</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      UNPACKAGED app. EmbeddedVoiceSpeaker.Load stages the native Azure Embedded
      Speech runtime next to the executable in the (writable) output folder. A
      packaged app installs to the read-only WindowsApps location where that
      staging would fail, so this sample must run without package identity.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>

    <!--
      The native core lands in the output root, so the app must be built for a
      concrete runtime. This machine is ARM64. Build/run with an explicit RID:
      dotnet run -r win-arm64  (or  -r win-x64).
    -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\StoreLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Windows.Speech.csproj" />
  </ItemGroup>

  <!-- Subtitle parsing and sentence grouping now live in the platform
       (SubtitleParser / CueSentenceGrouper). Reuse only the voice-selection
       helper from the SpeakSubtitles sample. -->
  <ItemGroup>
    <Compile Include="..\SpeakSubtitles\Selection.cs" Link="Selection.cs" />
  </ItemGroup>
</Project>
